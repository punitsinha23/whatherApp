{
  "cli": {
    "version": ">= 16.3.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "apk" // or "aab" if you're submitting to Play Store
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
